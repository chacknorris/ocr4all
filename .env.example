# Database
DATABASE_URL=postgresql+asyncpg://ocr4all:ocr4all@localhost:5433/ocr4all

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_PATH=./storage
STORAGE_TYPE=local

# S3 (optional)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ocr4all

# Tesseract
TESSERACT_CMD=/usr/local/bin/tesseract
TESSERACT_LANG=spa+eng

# LLM Configuration
LLM_PROVIDER=ollama
LLM_MODEL=llama3.2
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1000
LLM_TIMEOUT=60
